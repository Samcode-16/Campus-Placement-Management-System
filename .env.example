# Supabase PostgreSQL Connection String (Session pooler mode recommended for migrations)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Django Secret Key (optional for local dev, auto-generated on Render)
SECRET_KEY=your-secret-key-here

# Production Settings (Defaults: DEBUG=True for local, False on Render)
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
